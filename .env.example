# Copy file này thành .env, rồi thay MAT_KHAU_MYSQL_CUA_BAN bằng mật khẩu
# root MySQL trên máy của bạn. Gõ mật khẩu trực tiếp vào file .env trên
# máy của bạn, KHÔNG gửi mật khẩu qua chat, KHÔNG đưa .env lên GitHub.
DATABASE_URL=mysql://root:MAT_KHAU_MYSQL_CUA_BAN@localhost:3306/sofa_duy_ngoc

# --- Cloudflare D1 (chỉ dùng khi deploy lên Cloudflare Pages) ---
# Trên Cloudflare Pages, web dùng database D1 "sofa-duy-ngoc" qua
# binding DB khai báo trong wrangler.toml — KHÔNG cần DATABASE_URL
# ở đó. Trước khi deploy, Sơn cần tạo database D1 tên "sofa-duy-ngoc"
# trong Cloudflare dashboard rồi dán database ID vào wrangler.toml,
# sau đó nạp dữ liệu bằng file database/d1/sofa-duy-ngoc-d1.sql
# (xem hướng dẫn ở đầu file đó).
#
# --- Thử D1 trên máy local (tùy chọn, mặc định TẮT) ---
# `npm run dev` bình thường vẫn dùng MySQL local (DATABASE_URL ở trên).
# Muốn thử chạy local với D1 (miniflare) thì đặt:
# USE_D1_DEV=1
# rồi chạy `npm run dev`. Bỏ dòng này (hoặc đặt =0) để về lại MySQL.
# USE_D1_DEV=1
